{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "linkgate setup",
  "version": "0.1.0",
  "identifier": "uk.zachlagden.linkgate.setup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "linkgate setup",
        "width": 520,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
