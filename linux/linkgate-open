#!/usr/bin/env bash
set -euo pipefail

exe="__LINKGATE_EXE__"

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "usage: linkgate-open <url or file>" >&2
  exit 2
fi

if ! grep -qs '^enabled' /proc/sys/fs/binfmt_misc/WSLInterop; then
  echo "linkgate: WSL interop is disabled, so Windows programs can't start" >&2
  exit 1
fi

if [ ! -x "$exe" ]; then
  echo "linkgate: $exe is missing, run scripts/install.sh" >&2
  exit 1
fi

urldecode() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]), end="")' "$1"
}

urlencode() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="/:"), end="")' "$1"
}

target=$1
case $target in
  file:///*) target=$(urldecode "${target#file://}") ;;
  file://localhost/*) target=$(urldecode "${target#file://localhost}") ;;
esac

if [[ ! $target =~ ^[A-Za-z][A-Za-z0-9+.-]*: ]] && [ -e "$target" ]; then
  windows_path=$(wslpath -m "$(realpath "$target")")
  if [[ $windows_path == //* ]]; then
    target="file:$(urlencode "$windows_path")"
  else
    target="file:///$(urlencode "$windows_path")"
  fi
fi

setsid "$exe" "$target" </dev/null >/dev/null 2>&1 &
